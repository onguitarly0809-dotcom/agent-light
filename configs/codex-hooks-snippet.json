{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codex-hud hook",
            "timeout": 10,
            "statusMessage": "codex-hud"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node E:/agent-light-main/hook-client.mjs thinking codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node E:/agent-light-main/hook-client.mjs idle codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node E:/agent-light-main/hook-client.mjs running codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node E:/agent-light-main/lib/post-tool-codex.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node E:/agent-light-main/hook-client.mjs alarm codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node E:/agent-light-main/hook-client.mjs idle codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
